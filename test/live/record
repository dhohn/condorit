#!/bin/sh
# Record the fixtures of the version tests from htcondor/mini:TAG:
#
#   test/live/record TAG      e.g. 25.0.13-el9, or latest
#
# Starts the pool (see pool), runs the scenario, records every view and
# stops the pool.  The fixtures land in test/fixtures/versions/VERSION/,
# VERSION being what condor_version says.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
"$here/pool" start "${1:?usage: record TAG}"
trap '"$here/pool" stop' EXIT
"$here/scenario"
version=$("$here/bin/condor_version" | sed -n 's/^\$CondorVersion: \([0-9.]*\) .*/\1/p')
out=$root/test/fixtures/versions/$version
rm -rf "$out"
${EMACS:-emacs} -Q --batch -L "$root/lisp" --eval '(package-initialize)' -l "$here/record.el" "$out"
echo "Recorded HTCondor $version in $out"
